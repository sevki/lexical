// $FlowFixMe[untyped-import]: loro-crdt not typed
import type {LoroDoc} from 'loro-crdt';
import type {
  DecoratorNode,
  EditorState,
  ElementNode,
  LexicalCommand,
  LexicalEditor,
  LexicalNode,
  LineBreakNode,
  NodeMap,
  NodeKey,
  TextNode,
} from 'lexical';

// $FlowFixMe[unclear-type]: todo
export type LoroEvent = Object;

export type UserState = {
  anchorPos: null | {key: string, offset: number},
  color: string,
  focusing: boolean,
  focusPos: null | {key: string, offset: number},
  name: string,
};

export type ProviderAwareness = {
  getLocalState: () => UserState | null,
  getStates: () => Map<number, UserState>,
  off: (type: 'update', cb: () => void) => void,
  on: (type: 'update', cb: () => void) => void,
  setLocalState: (UserState) => void,
};

declare interface Provider {
  awareness: ProviderAwareness;
  connect(): void | Promise<void>;
  disconnect(): void;
  off(type: 'sync', cb: (isSynced: boolean) => void): void;
  // $FlowFixMe[unclear-type]: temp
  off(type: 'update', cb: (any) => void): void;
  off(type: 'status', cb: ({status: string}) => void): void;
  off(type: 'reload', cb: (doc: LoroDoc) => void): void;
  on(type: 'sync', cb: (isSynced: boolean) => void): void;
  on(type: 'status', cb: ({status: string}) => void): void;
  // $FlowFixMe[unclear-type]: temp
  on(type: 'update', cb: (any) => void): void;
  on(type: 'reload', cb: (doc: LoroDoc) => void): void;
}

export type ClientID = string;

// $FlowFixMe[unclear-type]: work around for internal
export type LoroText = Object;
// $FlowFixMe[unclear-type]: work around for internal
export type LoroMap = Object;
// $FlowFixMe[unclear-type]: work around for internal
export type LoroUndoManager = Object;

export type CursorSelection = {
  anchor: {
    key: NodeKey,
    offset: number,
  },
  caret: HTMLElement,
  color: string,
  focus: {
    key: NodeKey,
    offset: number,
  },
  name: HTMLSpanElement,
  selections: Array<HTMLElement>,
};

export type Cursor = {
  color: string,
  name: string,
  selection: null | CursorSelection,
};

declare export function createBinding(
  editor: LexicalEditor,
  provider: Provider,
  id: string,
  doc: LoroDoc,
  docMap: Map<string, LoroDoc>,
): Binding;

declare export function createUndoManager(
  binding: BaseBinding,
  root: LoroDoc,
): LoroUndoManager;

declare export function initLocalState(
  provider: Provider,
  name: string,
  color: string,
  focusing: boolean,
  awarenessData: {...},
): void;

declare export function setLocalStateFocus(
  provider: Provider,
  name: string,
  color: string,
  focusing: boolean,
  awarenessData: {...},
): void;

declare export function syncLexicalUpdateToLoro(
  binding: Binding,
  provider: Provider,
  prevEditorState: EditorState,
  currEditorState: EditorState,
  dirtyElements: Map<NodeKey, boolean>,
  dirtyLeaves: Set<NodeKey>,
  normalizedNodes: Set<NodeKey>,
  tags: Set<string>,
): void;

declare export function syncLoroChangesToLexical(
  binding: Binding,
  provider: Provider,
  // $FlowFixMe[unclear-type]: temp
  events: Array<any>,
  isFromUndoManger: boolean,
): void;

declare export var CONNECTED_COMMAND: LexicalCommand<boolean>;
declare export var TOGGLE_CONNECT_COMMAND: LexicalCommand<boolean>;

export type BaseBinding = {
  clientID: string,
  // $FlowFixMe[unclear-type]: temp
  cursors: Map<ClientID, any>,
  cursorsContainer: null | HTMLElement,
  doc: LoroDoc,
  docMap: Map<string, LoroDoc>,
  editor: LexicalEditor,
  id: string,
  nodeProperties: Map<string, {[string]: mixed}>,
  excludedProperties: Map<Class<LexicalNode>, Set<string>>,
};

export type Binding = {
  ...BaseBinding,
  // $FlowFixMe[unclear-type]: temp
  collabNodeMap: Map<NodeKey, any>,
  // $FlowFixMe[unclear-type]: temp
  root: any,
};

export type {Provider};
